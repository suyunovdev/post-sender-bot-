[Unit]
Description=Telegram Tech News Bot (RSS + original + loyiha -> Gemini -> Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/home/deploy/apps/tg-news-bot
EnvironmentFile=/home/deploy/apps/tg-news-bot/.env
ExecStart=/usr/bin/node dist/index.js
# Log stdout/stderr journalga tushadi: journalctl -u tg-news-bot
StandardOutput=journal
StandardError=journal
# Xavfsizlik cheklovlari (senior amaliyot)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

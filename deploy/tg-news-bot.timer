[Unit]
Description=Tech News Bot'ni jadval bo'yicha ishga tushiradi

[Timer]
# Har kuni soat 10:00 va 19:00 da (Toshkent vaqti bilan) ishga tushadi.
# Har ishда MAX_POSTS_PER_RUN (standart 3) tagacha post → kuniga ~6 post.
OnCalendar=*-*-* 10,19:00:00 Asia/Tashkent
# Server o'chib qolган paytdagi o'tkazib yuborilgan ishni keyin bajaradi
Persistent=true
# Aniq vaqtdan ±120s tasodifiy siljish (bir vaqtda yuklamani kamaytirish)
RandomizedDelaySec=120

[Install]
WantedBy=timers.target

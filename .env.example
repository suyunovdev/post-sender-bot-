# --- Telegram ---
# @BotFather'dan olingan bot tokeni
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Kanal @username (masalan @mytechchannel) yoki raqamli ID (masalan -1001234567890).
# Bot kanalga ADMIN qilib qo'shilgan bo'lishi shart.
TELEGRAM_CHANNEL_ID=@your_channel

# --- Gemini (Google) ---
GEMINI_API_KEY=AIza...
# Gemini modeli (bo'sh qoldirilsa gemini-flash-latest ishlatiladi)
GEMINI_MODEL=gemini-flash-latest

# --- Sozlamalar ---
# Bir marta ishga tushganda ko'pi bilan nechta post yuboriladi
MAX_POSTS_PER_RUN=3

# SQLite bazasi joyi (yuborilganlarni takrorlamaslik uchun)
DB_PATH=./data/state.sqlite

# Postlar tili (prompt uchun): uz | ru | en
POST_LANG=uz

# 1 = rasm bo'lsa rasm bilan yuborsin, 0 = faqat matn
SEND_IMAGES=1

# Har post oxiridagi imzo (ixtiyoriy). Bo'sh = imzosiz. Masalan: POST_SIGNATURE=✍️ @Suyunov_dev1
POST_SIGNATURE=

# --- Aralash rejim (noldan original post) ---
# Kanal mavzusi — agent noldan post yozganda shu doirada yozadi.
CHANNEL_TOPIC=IT, sun'iy intellekt, dasturlash va texnologiya

# Kontent navbati (aralash rejim). Turlar: rss | original | project.
# Ketma-ketlik bo'ylab aylanadi. Masalan quyidagi => har 6 postда 4 RSS, 1 original, 1 loyiha.
CONTENT_PATTERN=rss,rss,original,rss,rss,project

# --- Admin-bot ---
# Post vaqtlari (Toshkent, HH:MM). Chatда /jadval bilan ham o'zgartiriladi.
SCHEDULE=10:00,19:00
# Admin-botga buyruq bera oladigan Telegram ID'lar (vergul bilan).
ADMIN_USER_IDS=6307446924

# ⚠️ CONTENT_PATTERN, SCHEDULE, POST_SIGNATURE, MAX_POSTS_PER_RUN va manba/loyihalar —
# birinchi ishga tushishда bazaga ko'chadi, keyin CHATДАН (admin-bot) boshqariladi.
# .env qiymatlari faqat baza bo'sh bo'lganда standart sifatida ishlatiladi.
